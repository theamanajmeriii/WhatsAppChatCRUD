<h1>New Chat</h1>

<form method="POST" action="/chats">

    <input
    type="text"
    name="from"
    placeholder="From">

    <br><br>

    <input
    type="text"
    name="to"
    placeholder="To">

    <br><br>

    <textarea
    name="message"
    placeholder="Message">
    </textarea>

    <br><br>

    <button>Send</button>

</form>